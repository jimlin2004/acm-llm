# ACM LLM Lab – example secrets file. Copy to `.env` and fill in real values.
#   cp .env.example .env

# OpenAI (used by litellm/config.yml → gpt-4o-mini)
OPENAI_API_KEY=

# HuggingFace token (optional) — speeds up model downloads & raises rate limits
HF_TOKEN=

# Other providers (optional) — fill in then uncomment the matching block in litellm/config.yml
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
