# ACM LLM Lab — LINE flow deploy. Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored — never commit real keys.

# --- Main LLM (OpenAI-hosted; no GPU needed) ---------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5.4-mini

# --- Intent router (structured-output classifier) ----------------------------
# OpenAI too, a cheap/fast model for latency-sensitive routing.
ROUTER_LLM_BASE_URL=https://api.openai.com/v1
ROUTER_LLM_API_KEY=sk-...
ROUTER_LLM_MODEL=gpt-4.1-nano

# --- sim-server (ngspice) — reached by service name over app-net -------------
SIM_API_URL=http://sim-server:9000/simulate
SIM_API_KEY=
SIM_TIMEOUT=180
SIM_RETRIES=1

# --- LINE bot ----------------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Public HTTPS base of the webhook tunnel (e.g. your ngrok fixed domain).
LINE_PUBLIC_BASE=https://<your-subdomain>.ngrok-free.dev
# Comma-separated LINE user ids allowed to use the bot; empty = everyone.
LINE_ALLOWED_USER_IDS=
LINE_RATE_N=5
LINE_RATE_WINDOW=60

# --- ngrok tunnel for the LINE webhook ---------------------------------------
NGROK_AUTHTOKEN=

# --- Circuit migration flow (optional) ---------------------------------------
MIGRATION_DRY_RUN=false
MIGRATION_LLM_PROVIDER=openai
MIGRATION_LLM_MODEL=gpt-5-mini

# --- Abuse guard -------------------------------------------------------------
MAX_CONCURRENT_FLOWS=3
